				{"name": "Create Membership Plan", "event": [{"listen": "test", "script": {"exec": ["var j=pm.response.json();if(j.success&&j.data){pm.collectionVariables.set('planId',j.data.id);}"]}}], "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"},{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"name\":\"Monthly Basic\",\"description\":\"Basic monthly membership\",\"durationDays\":30,\"price\":1500.00,\"currency\":\"INR\",\"includesTrainer\":false,\"maxFreezeDays\":5}"}, "url": "{{baseUrl}}/owner/memberships/plans/{{gymId}}"}},
