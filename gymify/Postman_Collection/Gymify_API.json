				{"name": "Change Password", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"},{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"currentPassword\":\"password123\",\"newPassword\":\"newpass123\"}"}, "url": "{{baseUrl}}/users/me/password"}},
