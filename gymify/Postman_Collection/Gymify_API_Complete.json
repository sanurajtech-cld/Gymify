{
	"info": {
		"_postman_id": "gymify-api-collection",
		"name": "Gymify API",
		"description": "Complete API collection for Gymify - Gym Management Application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080/api"},
		{"key": "accessToken", "value": ""},
		{"key": "refreshToken", "value": ""},
		{"key": "userId", "value": ""},
		{"key": "gymId", "value": ""},
		{"key": "planId", "value": ""},
		{"key": "membershipId", "value": ""},
		{"key": "exerciseId", "value": ""},
		{"key": "workoutPlanId", "value": ""},
		{"key": "assignmentId", "value": ""},
		{"key": "trainerId", "value": ""},
		{"key": "notificationId", "value": ""},
		{"key": "workoutLogId", "value": ""},
		{"key": "categoryId", "value": ""},
		{"key": "muscleGroupId", "value": ""}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{"name": "Register", "event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success) {", "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);", "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);", "    pm.collectionVariables.set('userId', jsonData.data.userId);", "}"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"phone\": \"+919876543210\",\n    \"role\": \"CUSTOMER\"\n}"}, "url": {"raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"]}}},
				{"name": "Login", "event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success) {", "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);", "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);", "    pm.collectionVariables.set('userId', jsonData.data.userId);", "}"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"}, "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}}},
				{"name": "Refresh Token", "event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success) {", "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);", "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);", "}"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"}, "url": {"raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"]}}},
				{"name": "Logout", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"]}}},
				{"name": "Request Password Reset", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"email\": \"user@example.com\"\n}"}, "url": {"raw": "{{baseUrl}}/auth/password/reset-request", "host": ["{{baseUrl}}"], "path": ["auth", "password", "reset-request"]}}},
				{"name": "Confirm Password Reset", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"token\": \"reset-token-here\",\n    \"newPassword\": \"newpassword123\"\n}"}, "url": {"raw": "{{baseUrl}}/auth/password/reset-confirm", "host": ["{{baseUrl}}"], "path": ["auth", "password", "reset-confirm"]}}}
			]
		},
		{
			"name": "Users",
			"item": [
				{"name": "Get My Profile", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"]}}},
				{"name": "Update My Profile", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"phone\": \"+919876543210\",\n    \"dateOfBirth\": \"1990-01-15\",\n    \"gender\": \"MALE\"\n}"}, "url": {"raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"]}}},
				{"name": "Change Password", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n    \"currentPassword\": \"password123\",\n    \"newPassword\": \"newpassword123\"\n}"}, "url": {"raw": "{{baseUrl}}/users/me/password", "host": ["{{baseUrl}}"], "path": ["users", "me", "password"]}}},
				{"name": "Deactivate Account", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"]}}},
				{"name": "Get User By ID", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"]}}}
			]
		},
		{
			"name": "Gyms (Public)",
			"item": [
				{"name": "Get All Gyms", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/gyms?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["gyms"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}}},
				{"name": "Get Gym By ID", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/gyms/{{gymId}}", "host": ["{{baseUrl}}"], "path": ["gyms", "{{gymId}}"]}}},
				{"name": "Search Gyms", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/gyms/search?query=fitness&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["gyms", "search"], "query": [{"key": "query", "value": "fitness"}, {"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}}},
				{"name": "Get Nearby Gyms", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/gyms/nearby?latitude=28.6139&longitude=77.2090&radiusKm=10", "host": ["{{baseUrl}}"], "path": ["gyms", "nearby"], "query": [{"key": "latitude", "value": "28.6139"}, {"key": "longitude", "value": "77.2090"}, {"key": "radiusKm", "value": "10"}]}}},
				{"name": "Get Gyms By City", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/gyms/city/Delhi?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["gyms", "city", "Delhi"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}}}
			]
		}
	]
}
