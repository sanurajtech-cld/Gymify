{
	"name": "Gym Owner",
	"item": [
		{
			"name": "Get My Gyms",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/owner/gyms", "host": ["{{baseUrl}}"], "path": ["owner", "gyms"]}
			}
		},
		{
			"name": "Create Gym",
			"event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success && jsonData.data) {", "    pm.collectionVariables.set('gymId', jsonData.data.id);", "}"]}}],
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}],
				"body": {"mode": "raw", "raw": "{\n    \"name\": \"FitZone Gym\",\n    \"description\": \"Premium fitness center with modern equipment\",\n    \"addressLine1\": \"123 Main Street\",\n    \"addressLine2\": \"Near Central Park\",\n    \"city\": \"Delhi\",\n    \"state\": \"Delhi\",\n    \"country\": \"India\",\n    \"postalCode\": \"110001\",\n    \"latitude\": 28.6139,\n    \"longitude\": 77.2090,\n    \"phone\": \"+911234567890\",\n    \"email\": \"contact@fitzone.com\",\n    \"website\": \"https://fitzone.com\",\n    \"operatingHours\": [\n        {\"dayOfWeek\": 1, \"openTime\": \"06:00\", \"closeTime\": \"22:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 2, \"openTime\": \"06:00\", \"closeTime\": \"22:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 3, \"openTime\": \"06:00\", \"closeTime\": \"22:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 4, \"openTime\": \"06:00\", \"closeTime\": \"22:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 5, \"openTime\": \"06:00\", \"closeTime\": \"22:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 6, \"openTime\": \"08:00\", \"closeTime\": \"20:00\", \"isClosed\": false},\n        {\"dayOfWeek\": 0, \"openTime\": null, \"closeTime\": null, \"isClosed\": true}\n    ]\n}"},
				"url": {"raw": "{{baseUrl}}/owner/gyms", "host": ["{{baseUrl}}"], "path": ["owner", "gyms"]}
			}
		},
		{
			"name": "Update Gym",
			"request": {
				"method": "PUT",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}],
				"body": {"mode": "raw", "raw": "{\n    \"name\": \"FitZone Premium Gym\",\n    \"description\": \"Updated description\",\n    \"phone\": \"+911234567899\"\n}"},
				"url": {"raw": "{{baseUrl}}/owner/gyms/{{gymId}}", "host": ["{{baseUrl}}"], "path": ["owner", "gyms", "{{gymId}}"]}
			}
		},
		{
			"name": "Create Membership Plan",
			"event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success && jsonData.data) {", "    pm.collectionVariables.set('planId', jsonData.data.id);", "}"]}}],
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}],
				"body": {"mode": "raw", "raw": "{\n    \"name\": \"Monthly Basic\",\n    \"description\": \"Basic monthly membership\",\n    \"durationDays\": 30,\n    \"price\": 1500.00,\n    \"currency\": \"INR\",\n    \"includesTrainer\": false,\n    \"maxFreezeDays\": 5\n}"},
				"url": {"raw": "{{baseUrl}}/owner/memberships/plans/{{gymId}}", "host": ["{{baseUrl}}"], "path": ["owner", "memberships", "plans", "{{gymId}}"]}
			}
		},
		{
			"name": "Get Gym Memberships",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/owner/memberships/gym/{{gymId}}?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["owner", "memberships", "gym", "{{gymId}}"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
			}
		},
		{
			"name": "Assign Trainer to Membership",
			"request": {
				"method": "PUT",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/owner/memberships/{{membershipId}}/assign-trainer/{{trainerId}}", "host": ["{{baseUrl}}"], "path": ["owner", "memberships", "{{membershipId}}", "assign-trainer", "{{trainerId}}"]}
			}
		},
		{
			"name": "Get Gym Payments",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/owner/memberships/payments/{{gymId}}?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["owner", "memberships", "payments", "{{gymId}}"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
			}
		}
	]
}
