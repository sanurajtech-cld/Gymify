{
	"name": "Admin",
	"item": [
		{
			"name": "Get Pending Gyms",
			"request": {
				"method": "GET",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/admin/gyms/pending?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["admin", "gyms", "pending"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}
			}
		},
		{
			"name": "Approve Gym",
			"request": {
				"method": "PUT",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/admin/gyms/{{gymId}}/approve", "host": ["{{baseUrl}}"], "path": ["admin", "gyms", "{{gymId}}", "approve"]}
			}
		},
		{
			"name": "Reject Gym",
			"request": {
				"method": "PUT",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/admin/gyms/{{gymId}}/reject", "host": ["{{baseUrl}}"], "path": ["admin", "gyms", "{{gymId}}", "reject"]}
			}
		},
		{
			"name": "Suspend Gym",
			"request": {
				"method": "PUT",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
				"url": {"raw": "{{baseUrl}}/admin/gyms/{{gymId}}/suspend", "host": ["{{baseUrl}}"], "path": ["admin", "gyms", "{{gymId}}", "suspend"]}
			}
		},
		{
			"name": "Create Exercise",
			"event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if(jsonData.success && jsonData.data) {", "    pm.collectionVariables.set('exerciseId', jsonData.data.id);", "}"]}}],
			"request": {
				"method": "POST",
				"header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}, {"key": "Content-Type", "value": "application/json"}],
				"body": {"mode": "raw", "raw": "{\n    \"name\": \"Barbell Squat\",\n    \"description\": \"A compound exercise targeting the lower body\",\n    \"instructions\": \"1. Stand with feet shoulder-width apart\\n2. Place barbell on upper back\\n3. Bend knees and lower body\\n4. Push through heels to stand\",\n    \"difficulty\": \"INTERMEDIATE\",\n    \"exerciseType\": \"STRENGTH\",\n    \"imageUrl\": \"https://example.com/squat.jpg\",\n    \"videoUrl\": \"https://example.com/squat.mp4\",\n    \"caloriesPerMinute\": 8.5\n}"},
				"url": {"raw": "{{baseUrl}}/admin/exercises", "host": ["{{baseUrl}}"], "path": ["admin", "exercises"]}
			}
		}
	]
}
